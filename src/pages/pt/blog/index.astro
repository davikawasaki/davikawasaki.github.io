---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/cards/PostCard.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../../../i18n/utils';
import { SOCIAL_LINKS } from '../../../consts';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const locale = lang === 'pt' ? 'pt-BR' : 'en-US';
const mediumUrl = SOCIAL_LINKS.find((l) => l.name === 'medium')?.url ?? '#';

const allPosts = await getCollection('blog', ({ data }) => data.lang === lang && !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={`${t('blog.pageTitle')} — Davi Kawasaki`} description={t('blog.pageSubtitle')}>
  <section class="mx-auto max-w-6xl px-5 py-20 sm:px-8">
    <div class="max-w-2xl">
      <h1 class="font-display text-4xl font-bold" style="color: var(--color-text);">{t('blog.pageTitle')}</h1>
      <p class="mt-3 text-lg" style="color: var(--color-text-muted);">{t('blog.pageSubtitle')}</p>
    </div>

    {
      posts.length > 0 ? (
        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <PostCard
              href={localizePath(`/blog/${post.data.slug}`, lang)}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              locale={locale}
            />
          ))}
        </div>
      ) : (
        <div class="mt-12 rounded-2xl border p-10 text-center" style="border-color: var(--color-border);">
          <p style="color: var(--color-text-muted);">{t('blog.empty')}</p>
          <a
            href={mediumUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex items-center gap-1 text-sm font-semibold"
            style="color: var(--color-accent);"
          >
            {t('blog.readOnMedium')} &rarr;
          </a>
        </div>
      )
    }
  </section>
</BaseLayout>
