---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/shared/Button.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={`${t('404.title')} — Davi Kawasaki`} description={t('404.body')}>
  <section class="mx-auto flex min-h-[70vh] max-w-xl flex-col items-center justify-center px-5 py-24 text-center sm:px-8">
    <p class="font-display text-7xl font-extrabold" style="color: var(--color-accent);">404</p>
    <h1 class="font-display mt-4 text-3xl font-bold" style="color: var(--color-text);">{t('404.title')}</h1>
    <p class="mt-3" style="color: var(--color-text-muted);">{t('404.body')}</p>
    <Button href={localizePath('/', lang)} variant="solid" size="md" class="mt-8">
      {t('404.cta')}
    </Button>
  </section>
</BaseLayout>
