---
import Button from '../shared/Button.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="mx-auto max-w-6xl px-5 py-20 sm:px-8">
  <div
    class="cta-panel relative overflow-hidden rounded-3xl px-8 py-16 text-center sm:px-16"
  >
    <div class="cta-glow" aria-hidden="true"></div>
    <h2 class="font-display relative text-3xl font-bold text-white sm:text-4xl">{t('cta.title')}</h2>
    <p class="relative mx-auto mt-4 max-w-xl text-violet-100/80">{t('cta.subtitle')}</p>
    <div class="relative mt-8">
      <Button href={localizePath('/contact', lang)} variant="solid" size="lg">
        {t('cta.button')}
      </Button>
    </div>
  </div>
</section>

<style>
  .cta-panel {
    background: #120e1f;
  }
  .cta-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 70% at 50% 0%, rgba(124, 58, 237, 0.5), transparent 70%);
  }
</style>
