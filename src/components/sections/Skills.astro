---
import Badge from '../shared/Badge.astro';
import { skillGroups } from '../../data/experience';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="border-y" style="border-color: var(--color-border); background-color: var(--color-surface);">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8">
    <div class="max-w-2xl">
      <h2 class="font-display text-3xl font-bold" style="color: var(--color-text);">{t('skills.title')}</h2>
      <p class="mt-2" style="color: var(--color-text-muted);">{t('skills.subtitle')}</p>
    </div>

    <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        skillGroups.map((group) => (
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wide" style="color: var(--color-text-muted);">
              {group.title[lang]}
            </h3>
            <div class="mt-3 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <Badge>{item}</Badge>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
