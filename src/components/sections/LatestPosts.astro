---
import { getCollection } from 'astro:content';
import PostCard from '../cards/PostCard.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';
import { SOCIAL_LINKS } from '../../consts';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const locale = lang === 'pt' ? 'pt-BR' : 'en-US';
const mediumUrl = SOCIAL_LINKS.find((l) => l.name === 'medium')?.url ?? '#';

const allPosts = await getCollection('blog', ({ data }) => data.lang === lang && !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---

<section class="border-y" style="border-color: var(--color-border); background-color: var(--color-surface);">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-2xl">
        <h2 class="font-display text-3xl font-bold" style="color: var(--color-text);">{t('blog.title')}</h2>
        <p class="mt-2" style="color: var(--color-text-muted);">{t('blog.subtitle')}</p>
      </div>
      {
        posts.length > 0 && (
          <a href={localizePath('/blog', lang)} class="text-sm font-semibold" style="color: var(--color-accent);">
            {t('blog.viewAll')} &rarr;
          </a>
        )
      }
    </div>

    {
      posts.length > 0 ? (
        <div class="mt-10 grid gap-6 sm:grid-cols-3">
          {posts.map((post) => (
            <PostCard
              href={localizePath(`/blog/${post.data.slug}`, lang)}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              locale={locale}
            />
          ))}
        </div>
      ) : (
        <div class="mt-10 rounded-2xl border p-8 text-center" style="border-color: var(--color-border);">
          <p style="color: var(--color-text-muted);">{t('blog.empty')}</p>
          <a
            href={mediumUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex items-center gap-1 text-sm font-semibold"
            style="color: var(--color-accent);"
          >
            {t('blog.readOnMedium')} &rarr;
          </a>
        </div>
      )
    }
  </div>
</section>
