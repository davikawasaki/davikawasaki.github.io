---

<ul class:list={['flex items-center gap-3', className]}>
  {
    SOCIAL_LINKS.map((link) => (
      <li>
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer me"
          aria-label={link.label}
          class="grid size-9 place-items-center rounded-full border border-[var(--color-border)] text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
        >
          <svg class={iconClass} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={icons[link.name]} />
          </svg>
        </a>
      </li>
    ))
  }
</ul>
