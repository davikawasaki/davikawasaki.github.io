---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center rounded-full border border-[var(--color-border)] bg-[var(--color-surface-2)] px-3 py-1 text-xs font-medium text-[var(--color-text-muted)]',
    className,
  ]}
>
  <slot />
</span>
